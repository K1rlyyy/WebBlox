                                        <Border Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="8" Padding="8" Margin="0,8,0,2"><TextBlock Text="Блоки зберігаються в .webblox. Щоб виконати їх на сторінці, згенеруй JS-код (або додай його до редактора), потім натисни «Перегляд». Використовуй лише власний код, якому довіряєш." TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource ThemeTextBrush}"/></Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="⌨ Код JavaScript">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
                                    <StackPanel Margin="4,8,4,8">
                                        <TextBlock Text="JAVASCRIPT · РЕДАКТОР КОДУ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,0,4,7"/>
                                        <TextBlock Text="Редагуй код вручну або згенеруй його з візуальних блоків. Код збережеться в проєкті й потрапить до експортованого HTML." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,0,4,9"/>
                                        <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="2,2,2,7">
                                            <StackPanel>
                                                <TextBlock Text="ШВИДКІ ПРИКЛАДИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="2,0,2,5"/>
                                                <WrapPanel><Button Content="Клік по кнопці" Tag="alert" Click="JavaScriptExample_Click"/><Button Content="Лічильник" Tag="counter" Click="JavaScriptExample_Click"/></WrapPanel>
                                                <TextBlock Text="Для прикладу кнопки задай HTML-кнопці ID myButton. Для лічильника створи кнопку з ID counterButton та текстовий елемент з ID counterValue." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" Margin="3,5,3,2"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="2,0,2,7">
                                            <StackPanel>
                                                <TextBlock Text="JAVASCRIPT-КОД" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="2,0,2,5"/>
                                                <TextBox x:Name="JavaScriptBox" MinHeight="300" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="{DynamicResource ThemeCodeBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Margin="3,4,3,8" TextChanged="JavaScript_TextChanged" ToolTip="JavaScript, який буде виконано в браузері під час перегляду сторінки"/>
                                                <WrapPanel><Button Content="Імпорт .js" Click="ImportJavaScript_Click"/><Button Content="Експорт .js" Click="ExportJavaScript_Click"/><Button Content="Очистити" Click="ClearJavaScript_Click"/></WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="9" Padding="9" Margin="2,0,2,4"><TextBlock Text="Перегляд відкривається в браузері. Помилки виконання можна побачити в консолі браузера (F12). Код блоків спершу потрібно перенести в редактор JS кнопкою «Згенерувати JS» або «Додати до коду»." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}"/></Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>