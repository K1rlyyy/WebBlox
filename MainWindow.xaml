<Window x:Class="WebBlox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebBlox — Visual HTML Builder" Icon="pack://application:,,,/Assets/WebBloxLogo.ico" Height="920" Width="1600"
        MinHeight="700" MinWidth="1120" Background="{DynamicResource ThemeWindowBrush}"
        Foreground="{DynamicResource ThemeTextBrush}" WindowStartupLocation="CenterScreen" PreviewMouseWheel="UniformScroll_PreviewMouseWheel" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ModeSwitchStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#35516F"/>
            <Setter Property="Background" Value="#E8F1FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SwitchBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#6D9FD0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemePanelBrush}" Padding="16,11" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="36" Height="36" Margin="0,0,10,0"
                           Source="pack://application:,,,/Assets/WebBloxLogo.png"
                           Stretch="Uniform" ToolTip="Логотип WebBlox"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="WebBlox" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="VISUAL WEBSITE BUILDER" FontSize="9" Foreground="{DynamicResource ThemeMutedBrush}"/>
                    </StackPanel>
                    <Button Content="＋ Нова сторінка" Click="NewPage_Click"/>
                    <Button Content="▶ Перегляд" Click="Preview_Click" Background="{DynamicResource ThemeAccentBrush}" Foreground="White"/>
                    <Button Content="Експорт HTML" Click="Export_Click"/>
                    <Button Content="Зберегти" Click="Save_Click"/>
                    <Button Content="Відкрити" Click="Open_Click"/>
                    <Button x:Name="ThemeToggleButton" Click="ThemeToggle_Click" ToolTip="Перемкнути світлу / темну тему" Padding="10,7" Margin="8,3,3,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeIcon" Text="☀" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="#E6A323" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="ThemeLabel" Text="Світла" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="Готово · Перетягни тег на полотно" Foreground="{DynamicResource ThemeMutedBrush}" VerticalAlignment="Center" Margin="14,0,4,0"/>
            </Grid>
        </Border>
        <Grid Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="350" MinWidth="270"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource ThemePanelBrush}" CornerRadius="14" Padding="12" ClipToBounds="True">
                <ScrollViewer x:Name="LibraryScrollViewer" SizeChanged="LibraryScrollViewer_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
                    <StackPanel>
                        <TextBlock Text="БІБЛІОТЕКА" FontSize="11" FontWeight="Bold" Foreground="#315F91" Margin="4,4,4,8"/>
                        <UniformGrid Columns="3" Margin="2,0,2,9">
                            <RadioButton x:Name="HtmlModeButton" Content="HTML" IsChecked="True" GroupName="EditorMode" Checked="EditorMode_Checked" HorizontalContentAlignment="Center" Padding="8,7" Style="{StaticResource ModeSwitchStyle}"/>
                            <RadioButton x:Name="CssModeButton" Content="CSS" GroupName="EditorMode" Checked="EditorMode_Checked" HorizontalContentAlignment="Center" Padding="8,7" Style="{StaticResource ModeSwitchStyle}"/>
                            <RadioButton x:Name="JsModeButton" Content="JS" ToolTip="JavaScript · готові функції та шаблони" GroupName="EditorMode" Checked="EditorMode_Checked" HorizontalContentAlignment="Center" Padding="8,7" Style="{StaticResource ModeSwitchStyle}"/>
                        </UniformGrid>
                        <StackPanel x:Name="HtmlLibraryPanel">
                            <TextBlock Text="HTML · ЕЛЕМЕНТИ СТОРІНКИ" FontSize="10" FontWeight="Bold" Foreground="#315F91" Margin="4,0,4,5"/>
                            <TextBlock Text="Обери кольорову категорію, потім потрібний елемент. Наведи курсор або вибери тег, щоб прочитати пояснення." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,0,4,8"/>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Пошук HTML-тегів" Margin="2,0,2,7"/>
                            <Grid Margin="0,2,0,0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="КАТЕГОРІЇ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="HtmlPaletteCategoryList" Height="440" MinHeight="260" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="HtmlPaletteCategory_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryCard" Background="Transparent" CornerRadius="8" Padding="1"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryCard" Property="BorderBrush" Value="#6D9FD0"/><Setter TargetName="CategoryCard" Property="BorderThickness" Value="2"/><Setter TargetName="CategoryCard" Property="Background" Value="#C7DCEF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryCard" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="7" Padding="7,9" Margin="2" HorizontalAlignment="Stretch" Width="Auto"><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="HtmlElementCountText" Text="HTML-ЕЛЕМЕНТИ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="PaletteList" Height="440" MinHeight="260" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="PaletteList_PreviewMouseLeftButtonDown" PreviewMouseMove="PaletteList_PreviewMouseMove" MouseDoubleClick="PaletteList_MouseDoubleClick" SelectionChanged="HtmlPaletteElement_SelectionChanged" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ElementCard" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ElementCard" Property="Background" Value="#C7DCEF"/><Setter TargetName="ElementCard" Property="BorderBrush" Value="#8AB8F2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ElementCard" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource ThemeSelectedBrush}" CornerRadius="8" Padding="9" Margin="3,8,3,6">
                                <StackPanel>
                                    <TextBlock Text="ЩО РОБИТЬ ЦЕЙ ЕЛЕМЕНТ?" FontSize="9" FontWeight="Bold" Foreground="#315F91"/>
                                    <TextBlock x:Name="HtmlPaletteHintText" Text="Вибери HTML-елемент зі списку, щоб побачити його призначення." TextWrapping="Wrap" FontSize="11" Foreground="#37649D" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Перетягни елемент на полотно або двічі клацни, щоб додати його." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,3,4,4"/>
                        </StackPanel>
                        <StackPanel x:Name="CssLibraryPanel" Visibility="Collapsed">
                            <TextBlock Text="CSS · ОФОРМЛЕННЯ САЙТУ" FontSize="10" FontWeight="Bold" Foreground="#315F91" Margin="4,0,4,5"/>
                            <TextBlock Text="Обери кольорову категорію, потім потрібну властивість. Не потрібно знати CSS-код." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,0,4,8"/>
                            <Grid Margin="0,2,0,0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="КАТЕГОРІЇ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="CssPaletteCategoryList" Height="440" MinHeight="260" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="CssPaletteCategory_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryCard" Background="Transparent" CornerRadius="8" Padding="1"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryCard" Property="BorderBrush" Value="#6D9FD0"/><Setter TargetName="CategoryCard" Property="BorderThickness" Value="2"/><Setter TargetName="CategoryCard" Property="Background" Value="#C7DCEF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryCard" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="7" Padding="7,9" Margin="2" HorizontalAlignment="Stretch" Width="Auto"><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                    <TextBlock Text="ВЛАСТИВОСТІ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="CssPalettePropertyList" Height="440" MinHeight="260" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="CssPaletteProperty_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="PropertyCard" Background="Transparent" CornerRadius="8" Padding="2"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="PropertyCard" Property="Background" Value="#C7DCEF"/><Setter TargetName="PropertyCard" Property="BorderBrush" Value="#8AB8F2"/><Setter TargetName="PropertyCard" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PropertyCard" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="2" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="#2D4560" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Property}" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Hint}" Foreground="#526681" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="8" Padding="9" Margin="3,8,3,6">
                                <StackPanel>
                                    <TextBlock Text="ЩО ЦЕ РОБИТЬ?" FontSize="9" FontWeight="Bold" Foreground="#315F91"/>
                                    <TextBlock x:Name="CssPaletteHintText" Text="Вибери властивість зі списку." TextWrapping="Wrap" FontSize="11" Foreground="#2D4560" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Значення" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,4,4,3"/>
                            <TextBox x:Name="CssPaletteValueBox" ToolTip="Наприклад: blue, 20px, center"/>
                            <Button Content="＋ Додати властивість" Click="AddCssPaletteProperty_Click" Background="#8B5CF6" Foreground="White" HorizontalAlignment="Stretch" Margin="2,7,2,4"/>
                            <TextBlock Text="Після додавання відкрий вкладку CSS справа, щоб побачити всі стилі та код." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,3,4,4"/>
                        </StackPanel>
                        <StackPanel x:Name="JsLibraryPanel" Visibility="Collapsed">
                            <TextBlock Text="JS · ЛОГІКА ТА ГОТОВІ ФУНКЦІЇ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="4,0,4,5"/>
                            <TextBlock Text="Обери готову функцію для кнопок, форм, анімацій, даних або мініігор. Її можна додати до коду чи як візуальний блок." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}" Margin="4,0,4,8"/>
                            <TextBox x:Name="JsFunctionSearchBox" TextChanged="JsFunctionSearch_TextChanged" ToolTip="Пошук готових JavaScript-функцій" Margin="2,0,2,6"/>
                            <Grid Margin="0,2,0,0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="КАТЕГОРІЇ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="JsFunctionCategoryList" Height="360" MinHeight="230" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="JsFunctionCategory_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ScrollViewer.IsDeferredScrollingEnabled="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryCard" Background="Transparent" CornerRadius="8" Padding="1"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryCard" Property="BorderBrush" Value="#6D9FD0"/><Setter TargetName="CategoryCard" Property="BorderThickness" Value="2"/><Setter TargetName="CategoryCard" Property="Background" Value="#C7DCEF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryCard" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="7" Padding="7,9" Margin="2" HorizontalAlignment="Stretch" Width="Auto"><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="JsFunctionCountText" Text="ГОТОВІ ФУНКЦІЇ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedBrush}" Margin="5,0,4,4"/>
                                    <ListBox x:Name="JsFunctionPalette" Height="360" MinHeight="230" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="JsFunctionPalette_SelectionChanged" MouseDoubleClick="JsFunctionPalette_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ScrollViewer.IsDeferredScrollingEnabled="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,2,1,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="JsFunctionCard" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="JsFunctionCard" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/><Setter TargetName="JsFunctionCard" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="JsFunctionCard" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Color}" CornerRadius="6" Padding="7" Margin="1"><StackPanel><TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="#F7F9FC" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Category}" Foreground="#FFFFFF" FontSize="8" Opacity="0.88" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource ThemeAccentSoftBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3,7,3,5">
                                <StackPanel>
                                    <TextBlock x:Name="JsFunctionDetailsTitleText" Text="ОБЕРИ ФУНКЦІЮ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                    <TextBlock x:Name="JsFunctionDetailsDescriptionText" Text="Вибери картку, щоб переглянути опис і вимоги." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="JsFunctionRequirementsText" Text="" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Content="＋ Додати до JS-коду" Click="AppendJsFunction_Click" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" HorizontalAlignment="Stretch" Margin="2,3,2,4" ToolTip="Додати вибрану функцію в кінець редактора JavaScript"/>
                            <WrapPanel HorizontalAlignment="Stretch">
                                <Button Content="Замінити JS" Click="ReplaceJsFunction_Click" ToolTip="Замінити поточний JavaScript вибраним шаблоном"/>
                                <Button Content="Додати як блок" Click="AddJsFunctionAsBlock_Click" ToolTip="Додати всю функцію як окремий блок у JS-бібліотеці справа"/>
                                <Button Content="Візуальні блоки →" Click="ShowJsBlocks_Click" ToolTip="Відкрити редактор візуальних JavaScript-блоків справа"/>
                            </WrapPanel>
                            <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="3,7,3,4"><TextBlock Text="Порада: після додавання перевір селектори та ID у коді. Наприклад, #myButton означає елемент з ID myButton. Для мережевих запитів сайт може вимагати доступ до API (CORS)." TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource ThemeMutedBrush}"/></Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{DynamicResource ThemeBorderBrush}" Opacity="0.75" Cursor="SizeWE" ToolTip="Потягни, щоб змінити ширину бібліотеки"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="5,2,5,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="РОБОЧЕ ПОЛОТНО · HTML-СТРУКТУРА" FontSize="11" FontWeight="Bold" Foreground="#315F91"/><TextBlock Text="Перетягуй теги, вибирай блоки й налаштовуй вкладеність." FontSize="11" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeAccentSoftBrush}" CornerRadius="8" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="HTML + CSS + JS  ·  LIVE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}"/></Border>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource ThemeCanvasBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10" AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ThemePanelBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="1,0,1,8">
                            <DockPanel LastChildFill="True">
